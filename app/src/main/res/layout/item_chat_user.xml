<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical"
    android:paddingVertical="6dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="50dp"
        android:background="@drawable/bg_chat_bubble_user"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tv_chat_user_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="User question goes here"
            android:textColor="@color/bg_dark"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_chat_user_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:text="10:45 AM"
            android:textColor="#8007101F"
            android:textSize="10sp" />

    </LinearLayout>

</LinearLayout>
